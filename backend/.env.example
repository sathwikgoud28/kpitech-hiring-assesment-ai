# Copy this file to `.env` and adjust as needed.
# The app runs with sane defaults even if this file is absent.

# Secret used to sign JWT access tokens. CHANGE THIS IN ANY REAL DEPLOYMENT.
SECRET_KEY=dev-secret-change-me

# How long an access token stays valid.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# SQLAlchemy database URL. Default is a local SQLite file next to the backend.
DATABASE_URL=sqlite:///./jobboard.db

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --------------------------------------------------------------------------
# Optional: LLM re-ranking layer
# --------------------------------------------------------------------------
# Leave GROQ_API_KEY blank and everything still works - job matching falls back
# to the deterministic engine, which needs no network and no credentials.
#
# With a key set, the top results from that engine are re-ranked and
# re-explained by an LLM. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Any chat model Groq serves. Llama 3.3 70B is a good quality/latency balance.
GROQ_MODEL=llama-3.3-70b-versatile

# Give up on the LLM after this many seconds and return deterministic results.
GROQ_TIMEOUT_SECONDS=8

# How many of the top deterministic results are sent to the LLM to re-rank.
LLM_RERANK_CANDIDATES=8

# Final score = (1 - weight) * deterministic + weight * LLM relevance.
# 0.0 ignores the LLM's score entirely; 1.0 trusts it completely.
LLM_BLEND_WEIGHT=0.5
