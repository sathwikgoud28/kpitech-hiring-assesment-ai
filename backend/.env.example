# Copy this file to `.env` and adjust as needed.
# The app runs with sane defaults even if this file is absent.

# Secret used to sign JWT access tokens. CHANGE THIS IN ANY REAL DEPLOYMENT.
SECRET_KEY=dev-secret-change-me

# How long an access token stays valid.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# SQLAlchemy database URL. Default is a local SQLite file next to the backend.
DATABASE_URL=sqlite:///./jobboard.db

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
